{
	"version": 3,
	"routes": [
		{
			"src": "^/\\.well-known(?:/.*)?$"
		},
		{
			"src": "^/((?:[^/]+/)*[^/\\.]+)$",
			"headers": {
				"Location": "/$1/"
			},
			"status": 308
		},
		{
			"src": "^/((?:[^/]+/)*[^/]+\\.\\w+)/$",
			"headers": {
				"Location": "/$1"
			},
			"status": 308
		},
		{
			"src": "^/_astro(?:/(.*))$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_server-islands/([^/]+?)/$",
			"dest": "_render"
		},
		{
			"src": "^/_image/$",
			"dest": "_render"
		},
		{
			"src": "^/404/$",
			"dest": "_render"
		},
		{
			"src": "^/admin/equipe/$",
			"dest": "_render"
		},
		{
			"src": "^/admin/login/$",
			"dest": "_render"
		},
		{
			"src": "^/admin/novo/$",
			"dest": "_render"
		},
		{
			"src": "^/admin/sair/$",
			"dest": "_render"
		},
		{
			"src": "^/admin/([^/]+?)/excluir/$",
			"dest": "_render"
		},
		{
			"src": "^/admin/([^/]+?)/status/$",
			"dest": "_render"
		},
		{
			"src": "^/admin/([^/]+?)/$",
			"dest": "_render"
		},
		{
			"src": "^/admin/$",
			"dest": "_render"
		},
		{
			"src": "^/animais/([^/]+?)/$",
			"dest": "_render"
		},
		{
			"src": "^/sitemap\\.xml$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render"
		}
	]
}