---
// Mostra a foto do animal se o arquivo existir em src/assets/img/animais/.
// Se não existir, mostra uma ilustração com a cor do animal.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Animal } from '../data/animais';
import Mascote from './Mascote.astro';

interface Props {
  animal: Animal;
  largura?: number;
  sizes?: string;
  class?: string;
  prioridade?: boolean;
}
const { animal, largura = 640, sizes = '(min-width: 900px) 33vw, 100vw', class: cls, prioridade = false } = Astro.props;

const arquivos = import.meta.glob<{ default: ImageMetadata }>('../assets/img/animais/*.{jpg,jpeg,png,webp,avif}');
const chave = `../assets/img/animais/${animal.foto}`;
const carregar = arquivos[chave];
const imagem = carregar ? (await carregar()).default : null;
---

<div class:list={['foto', cls]} style={`--cor:${animal.cor}`}>
  {
    imagem ? (
      <Image
        src={imagem}
        alt={`${animal.nome}, ${animal.especie === 'cachorro' ? 'cachorro' : 'gato'} para adoção`}
        width={largura}
        widths={[320, 480, 640, 960]}
        sizes={sizes}
        loading={prioridade ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <Mascote especie={animal.especie} cor={animal.cor} />
    )
  }
</div>

<style>
  .foto {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: color-mix(in oklab, var(--cor) 60%, white);
    display: grid;
    place-items: center;
  }

  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--suave);
  }

  .foto :global(svg) {
    width: 78%;
    height: 78%;
    transition: transform 0.7s var(--mola);
  }
</style>
