---
// Foto do animal. Se não tiver foto cadastrada, mostra um espaço com patinha.
import type { Animal } from '../data/animais';
import Icone from './Icone.astro';

interface Props {
  animal: Pick<Animal, 'nome' | 'especie' | 'foto' | 'cor'>;
  largura?: number;
  class?: string;
  prioridade?: boolean;
}
const { animal, class: cls, prioridade = false } = Astro.props;
---

<div class:list={['foto', cls]} style={`--cor:${animal.cor}`}>
  {
    animal.foto ? (
      <img
        src={animal.foto}
        alt={`${animal.nome}, ${animal.especie === 'cachorro' ? 'cachorro' : 'gato'} para adoção`}
        width="1000"
        height="1000"
        loading={prioridade ? 'eager' : 'lazy'}
        fetchpriority={prioridade ? 'high' : 'auto'}
        decoding="async"
      />
    ) : (
      <span class="foto__vazia">
        <Icone nome="pata" />
        <span>{animal.nome}</span>
      </span>
    )
  }
</div>

<style>
  .foto {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: color-mix(in oklab, var(--cor) 60%, white);
    display: grid;
    place-items: center;
  }

  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--suave);
  }

  .foto__vazia {
    display: grid;
    place-items: center;
    gap: 10px;
    color: var(--verde-escuro);
    font-family: var(--fonte-titulo);
    font-size: 1.4rem;
    font-weight: 600;
  }

  .foto__vazia :global(svg) {
    width: 64px;
    height: 64px;
    opacity: 0.5;
  }
</style>
