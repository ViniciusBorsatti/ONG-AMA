---
// Patinhas decorativas flutuando no fundo.
import Icone from './Icone.astro';
const patas = [
  { x: '6%', y: '12%', s: 34, rot: -25, d: '0s' },
  { x: '14%', y: '70%', s: 22, rot: 15, d: '1.2s' },
  { x: '46%', y: '8%', s: 18, rot: 35, d: '2.4s' },
  { x: '86%', y: '18%', s: 28, rot: -10, d: '0.6s' },
  { x: '92%', y: '72%', s: 40, rot: 20, d: '1.8s' },
  { x: '60%', y: '88%', s: 20, rot: -35, d: '3s' },
];
---

<div class="patas" aria-hidden="true">
  {
    patas.map((p) => (
      <span class="pata flutua" style={`left:${p.x};top:${p.y};--s:${p.s}px;--rot:${p.rot}deg;--d:${p.d}`}>
        <Icone nome="pata" />
      </span>
    ))
  }
</div>

<style>
  .patas {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .pata {
    position: absolute;
    width: var(--s);
    height: var(--s);
    color: var(--verde);
    opacity: 0.14;
  }

  .pata :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
