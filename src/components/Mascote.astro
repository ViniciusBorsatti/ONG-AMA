---
// Ilustração simples usada no lugar da foto quando o arquivo ainda não existe.
import type { Especie } from '../data/animais';

interface Props {
  especie: Especie;
  cor: string;
  class?: string;
}
const { especie, cor, class: cls } = Astro.props;
---

<svg class={cls} viewBox="0 0 200 200" aria-hidden="true" style={`--cor:${cor}`}>
  <defs>
    <radialGradient id="brilho" cx="35%" cy="30%" r="80%">
      <stop offset="0" stop-color="#fff" stop-opacity="0.55" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
  </defs>
  <circle cx="100" cy="100" r="100" fill="var(--cor)" />
  <circle cx="100" cy="100" r="100" fill="url(#brilho)" />
  {
    especie === 'cachorro' ? (
      <g class="mascote mascote--cao">
        <ellipse class="orelha orelha--e" cx="52" cy="98" rx="22" ry="40" fill="#5a3a1e" />
        <ellipse class="orelha orelha--d" cx="148" cy="98" rx="22" ry="40" fill="#5a3a1e" />
        <ellipse cx="100" cy="112" rx="56" ry="52" fill="#b9814a" />
        <ellipse cx="100" cy="132" rx="30" ry="24" fill="#f3dcc0" />
        <ellipse cx="100" cy="122" rx="13" ry="9" fill="#2b1b10" />
        <circle class="olho" cx="80" cy="98" r="6.5" fill="#2b1b10" />
        <circle class="olho" cx="120" cy="98" r="6.5" fill="#2b1b10" />
        <circle cx="82" cy="96" r="2" fill="#fff" />
        <circle cx="122" cy="96" r="2" fill="#fff" />
        <path d="M88 140q12 12 24 0" stroke="#2b1b10" stroke-width="3.5" fill="none" stroke-linecap="round" />
        <path class="lingua" d="M93 142q7 16 14 0z" fill="#e8706f" />
      </g>
    ) : (
      <g class="mascote mascote--gato">
        <path class="orelha orelha--e" d="M46 92 52 42l34 30z" fill="#7a7a86" />
        <path class="orelha orelha--d" d="M154 92 148 42l-34 30z" fill="#7a7a86" />
        <path d="M54 88 57 54l24 22z" fill="#f2b8c6" />
        <path d="M146 88 143 54l-24 22z" fill="#f2b8c6" />
        <ellipse cx="100" cy="116" rx="54" ry="48" fill="#9c9ca8" />
        <ellipse class="olho" cx="80" cy="104" rx="8" ry="10" fill="#f3d34e" />
        <ellipse class="olho" cx="120" cy="104" rx="8" ry="10" fill="#f3d34e" />
        <ellipse cx="80" cy="104" rx="2.5" ry="8" fill="#1d1d24" />
        <ellipse cx="120" cy="104" rx="2.5" ry="8" fill="#1d1d24" />
        <path d="M95 124h10l-5 6z" fill="#f2a0b5" />
        <path d="M100 130q-6 8-12 4M100 130q6 8 12 4" stroke="#1d1d24" stroke-width="2.5" fill="none" stroke-linecap="round" />
        <g stroke="#e9e9ee" stroke-width="2" stroke-linecap="round" class="bigodes">
          <path d="M40 118h30M42 130l28-6M136 118h30M130 124l28 6" />
        </g>
      </g>
    )
  }
</svg>

<style>
  svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .orelha {
    transform-box: fill-box;
    transform-origin: 50% 0%;
    transition: transform 0.5s var(--mola);
  }

  .olho {
    transform-box: fill-box;
    transform-origin: center;
    animation: piscar 5s infinite;
  }

  .lingua {
    transform-box: fill-box;
    transform-origin: 50% 0%;
    transition: transform 0.4s var(--mola);
  }

  :global(.foto:hover) .orelha--e {
    transform: rotate(-10deg);
  }

  :global(.foto:hover) .orelha--d {
    transform: rotate(10deg);
  }

  :global(.foto:hover) .lingua {
    transform: scaleY(1.4);
  }

  @keyframes piscar {
    0%,
    92%,
    100% {
      transform: scaleY(1);
    }
    95% {
      transform: scaleY(0.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .olho {
      animation: none;
    }
  }
</style>
