---
import Admin from '../../../layouts/Admin.astro';
import FormAnimal from '../../../components/FormAnimal.astro';
import { buscarAnimalPorId } from '../../../lib/db';
import { salvarAnimal } from '../../../lib/salvar';

const animal = await buscarAnimalPorId(Astro.params.id!, Astro.locals.supabase);
if (!animal) return Astro.redirect('/admin/');

let erro: string | null = null;
let valores: Record<string, string> = {};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const r = await salvarAnimal(Astro.locals.supabase, form, animal);
  if (r.ok) return Astro.redirect('/admin/?ok=salvo');
  erro = r.erro ?? 'Erro desconhecido.';
  for (const [k, val] of form.entries()) if (typeof val === 'string') valores[k] = val;
}
---

<Admin titulo={`Editar ${animal.nome}`} erro={erro}>
  <div class="admin__cabeca">
    <h1>Editar {animal.nome}</h1>
    <a href={`/animais/${animal.slug}/`} target="_blank" rel="noopener" class="link-simples">Ver no site ↗</a>
  </div>
  <FormAnimal animal={animal} valores={valores} />
</Admin>
